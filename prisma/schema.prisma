generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  email      String
  phone      String
  officeArea String
  website    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agents     Agent[]
}

model Agent {
  id             String     @id @default(uuid())
  agencyId       String
  firstName      String
  lastName       String
  email          String     @unique
  phone          String
  yearsExperience Int
  isVerified     Boolean
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  agency         Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  properties     Property[]

  @@index([agencyId])
}

model Property {
  id           String         @id @default(uuid())
  agentId      String
  title        String
  description  String
  propertyType PropertyType
  listingType  ListingType
  area         String
  priceMinor   BigInt
  currency     String
  bedrooms     Int?
  bathrooms    Int?
  status       PropertyStatus
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([area])
  @@index([propertyType])
  @@index([listingType])
  @@index([status])
  @@index([priceMinor])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([listingType, priceMinor])
}

enum PropertyType {
  APARTMENT
  DUPLEX
  DETACHED_HOUSE
  TERRACE
  LAND
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
}
